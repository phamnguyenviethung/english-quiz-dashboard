# Không biến nào có prefix VITE_ — tất cả chỉ đọc phía server (vite dev proxy
# lúc dev, Vercel function lúc prod) nên không lọt vào bundle client.

# URL của english-quiz-api, không có dấu / ở cuối
API_BASE_URL=http://localhost:3399

# Super key của english-quiz-api, do proxy gắn vào header x-admin-key
ADMIN_API_KEY=

# Chỉ cần cho `vercel dev` / production: mật khẩu vào dashboard và secret ký
# cookie phiên (openssl rand -base64 32)
DASHBOARD_PASSWORD=
SESSION_SECRET=
